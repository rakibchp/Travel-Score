# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string. Use a database name in the path, e.g. /explore-bangladesh
# Use a separate database for development, preview and production.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/explore-bangladesh?retryWrites=true&w=majority

# Comma-separated list of browser origins allowed to call the API directly.
# In production the frontend proxies /api through its own domain, so this mostly matters for local dev.
CORS_ORIGINS=http://localhost:5173

# Public URL of the frontend (used in emails and share links from Phase 4/5)
APP_URL=http://localhost:5173

# Requests per IP per 15 minutes for the general API limiter
RATE_LIMIT_MAX=300
