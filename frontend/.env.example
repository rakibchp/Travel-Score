# Copy to .env.local for local development. Everything prefixed VITE_ is
# bundled into the browser — never put secrets here.

# Leave unset to use the default "/api/v1" (proxied by Vite in dev and by
# vercel.json in production). Only set it to call a backend on another origin.
# VITE_API_BASE_URL=http://localhost:5000/api/v1

# Where the Vite dev server proxies /api (not exposed to the browser)
DEV_API_PROXY_TARGET=http://localhost:5000
