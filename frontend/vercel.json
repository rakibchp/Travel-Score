{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://YOUR-BACKEND-PROJECT.vercel.app/api/:path*" },
    { "source": "/share/:path*", "destination": "https://YOUR-BACKEND-PROJECT.vercel.app/share/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
